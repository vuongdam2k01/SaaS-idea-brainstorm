# Sensitive raw material per idea (transcripts, real names, payments)
ideas/*/private/*
!ideas/*/private/.gitkeep

# Internal dogfood workspaces (simulated founder, quarantined data) - not real
# user ideas. Kept OUTSIDE ideas/ so the session-start sentinel ("state.json with
# pipeline_version beside it under ideas/") never reports them as user ideas —
# the state-schema rule "never inside the plugin" stays true without exceptions
# (conflicts-inventory C1). Kept locally for reference, excluded from release.
dogfood/*/
!dogfood/README.md

node_modules/
.DS_Store

# eval artefacts: fixtures are generated, results are per-run
evals/fixtures/generated/
evals/results/
